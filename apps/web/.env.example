# Copy to .env (never commit .env). Server-side only: no NEXT_PUBLIC_ prefix.

# "demo" = no real payment (orders marked payment status "demo"); "live" = Razorpay Checkout
PAYMENT_MODE=demo

# Live mode only. Get these from the Razorpay Dashboard. The secret must stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cash on Delivery is offered only for order totals up to this amount (INR). Placeholder, confirm with the client.
COD_MAX_AMOUNT=10000

# Neon PostgreSQL (spec 012). Placeholders only: put the real values in .env.
# Copy both from the Neon console > Connect (use a dev branch, not production).
# Pooled connection (host contains "-pooler"): used by the app and the seed.
DATABASE_URL="postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Direct connection (same host without "-pooler"): used by prisma migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/DATABASE?sslmode=require"
