# Copy to .env (never commit .env). Server-side only: no NEXT_PUBLIC_ prefix.

# "demo" = no real payment (orders marked payment status "demo"); "live" = Razorpay Checkout
PAYMENT_MODE=demo

# Live mode only. Get these from the Razorpay Dashboard. The secret must stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cash on Delivery is offered only for order totals up to this amount (INR). Placeholder, confirm with the client.
COD_MAX_AMOUNT=10000
