// Catalog (spec 012), accounts (spec 013), orders, addresses and saved items (spec 014),
// notifications (spec 016).
//
// Money is integer paise (₹1 = 100). GST is basis points (18% = 1800).
// Neon PostgreSQL. Connection URLs come from prisma.config.ts (DIRECT_URL) and lib/prisma-client.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  /// Existing ids are kept, e.g. "pd-006".
  id                 String           @id
  slug               String           @unique
  name               String
  brand              String
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  shortDescription   String
  description        String?
  pricePaise         Int
  originalPricePaise Int?
  onSale             Boolean          @default(false)
  /// null = GST is included in the price (current behaviour for all products).
  gstRateBps         Int?
  /// Stock for products without variants. Products with variants use ProductVariant.stock.
  stock              Int              @default(0)
  deliveryDays       Int?
  returnDays         Int?
  warrantyText       String?
  returnPolicy       String?
  inBox              String[]
  /// [{ "label": string, "value": string }]
  specs              Json             @default("[]")
  /// Paths under public/images, e.g. "/images/products/Drill.png". The first is the main image.
  images             String[]
  /// Homepage sections the product appears in: "popular", "featured".
  collections        String[]
  /// Position in the homepage Best Seller grid; null = not a best seller.
  bestSellerRank     Int?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  variants           ProductVariant[]
  reviews            Review[]
  orderItems         OrderItem[]
  savedBy            SavedItem[]
  notifications      Notification[]

  @@index([categoryId])
}

model ProductVariant {
  /// "{productId}:{value}", so stored carts that use the value keep working.
  id         String  @id
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Option group, e.g. "Size".
  name       String
  /// Chip text, e.g. "125 mm".
  value      String
  /// null = falls back to the product price.
  pricePaise Int?
  stock      Int     @default(0)
  sortOrder  Int     @default(0)

  orderItems OrderItem[]

  @@unique([productId, value])
}

enum ReviewStatus {
  published
  hidden
}

model Review {
  id               String       @id @default(cuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName       String
  /// 1 to 5 (checked in the migration).
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean      @default(false)
  /// true for reviews that came from the seed data.
  isSample         Boolean      @default(false)
  status           ReviewStatus @default(published)
  createdAt        DateTime     @default(now())

  @@unique([userId, productId])
  @@index([productId, status])
}

/**
 * Accounts (spec 013) ------------------------------------------------
 */

model User {
  id                String             @id @default(cuid())
  name              String
  /// Always stored lowercase.
  email             String             @unique
  phone             String?
  /// argon2id hash. The password itself is never stored.
  passwordHash      String
  /// Unused for now.
  emailVerifiedAt   DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          Session[]
  reviews           Review[]
  addresses         Address[]
  orders            Order[]
  savedItems        SavedItem[]
  notifications     Notification[]
  notificationReads NotificationRead[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the cookie token. The token itself lives only in the browser.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  /// Lowercase.
  email     String
  succeeded Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

/**
 * Orders, addresses, saved items (spec 014) --------------------------
 */

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  line1        String
  line2        String?
  city         String
  state        String
  pincode      String
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

enum OrderStatus {
  placed
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  razorpay
}

enum PaymentStatus {
  pending
  demo
  paid
  failed
  refunded
}

model Order {
  id                String         @id @default(cuid())
  /// "TS-20261120-0001": per-day counter in IST (OrderCounter).
  orderNumber       String         @unique
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus    @default(placed)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus
  subtotalPaise     Int
  gstPaise          Int
  deliveryPaise     Int
  totalPaise        Int
  /// Address snapshot: later address edits never change a placed order.
  fullName          String
  phone             String
  email             String
  line1             String
  line2             String?
  city              String
  state             String
  pincode           String
  instructions      String?
  estimatedDelivery DateTime
  /// Live mode only.
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  idempotencyKey    String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  items             OrderItem[]
  notifications     Notification[]

  @@index([userId, createdAt])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Snapshots keep the order correct if the product changes later.
  productNameSnapshot String
  variantNameSnapshot String?
  imageSnapshot       String?
  unitPricePaise      Int
  quantity            Int
  /// null = price included GST.
  gstRateBps          Int?
  lineTotalPaise      Int

  @@index([orderId])
  @@index([productId])
}

/// Per-day order number counter (key: "20261120", IST).
model OrderCounter {
  day   String @id
  value Int
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

/**
 * Notifications (spec 016) -------------------------------------------
 * Created only by lib/notifications/notification-service.ts.
 */

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS
  REVIEW_PUBLISHED
  NEW_PRODUCT
}

model Notification {
  id        String             @id @default(cuid())
  type      NotificationType
  /// Max 120 characters (checked by the service).
  title     String
  /// Max 300 characters (checked by the service).
  body      String?
  /// Relative path inside the site, e.g. "/orders/abc". Validated by the service.
  link      String
  /// Set for personal notifications; null for broadcasts (every user).
  userId    String?
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime           @default(now())
  reads     NotificationRead[]

  @@index([userId, createdAt])
  @@index([orderId])
}

/// Read state for both personal and broadcast notifications.
model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@index([userId])
}
